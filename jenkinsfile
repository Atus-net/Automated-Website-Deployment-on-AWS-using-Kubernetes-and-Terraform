pipeline {
    agent any

    environment {
        // Thông tin Docker Registry
        DOCKER_USER = 'latuss' // Username Docker Hub của bạn
        FE_IMAGE    = "${DOCKER_USER}/dolciluxe-frontend"
        BE_IMAGE    = "${DOCKER_USER}/dolciluxe-backend"
        IMAGE_TAG   = "${BUILD_NUMBER}"
        
        // IDs Credentials đã tạo trong Jenkins
        DOCKER_HUB_CREDS = 'docker-hub-creds'
        SONAR_TOKEN_ID   = 'sonar-token'
        VAULT_PASS_ID    = 'ansible-vault-pass'
        
        // Cấu hình SonarQube (Khớp với mục System Configuration)
        SONAR_SERVER_NAME = 'sonarqube'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    // Kiểm tra xem commit này thay đổi file ở thư mục nào
                    def changedFiles = sh(script: "git diff --name-only HEAD~1 HEAD", returnStdout: true).trim()
                    echo "Changed files: ${changedFiles}"
                    
                    env.FE_CHANGED = changedFiles.contains('frontend/') ? 'true' : 'false'
                    env.BE_CHANGED = changedFiles.contains('backend/') ? 'true' : 'false'
                    
                    echo "Frontend changed: ${env.FE_CHANGED}"
                    echo "Backend changed: ${env.BE_CHANGED}"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    // Sử dụng tool đã cấu hình trong Global Tool Configuration
                    def scannerHome = tool 'sonar-scanner'
                    withSonarQubeEnv("${SONAR_SERVER_NAME}") {
                        sh "/var/jenkins_home/sonar-scanner/bin/sonar-scanner"
                    }
                }
            }
        }

        stage('Build & Push Frontend') {
            when { expression { return env.FE_CHANGED == 'true' } }
            steps {
                script {
                    echo "Building and pushing frontend Docker image..."
                    sh "docker build -t ${FE_IMAGE}:${IMAGE_TAG} ./frontend"
                    sh "docker push ${FE_IMAGE}:${IMAGE_TAG}"
                    sh "docker push ${FE_IMAGE}:latest"
                }
            }
        }

        stage('Build & Push Backend') {
            when { expression { return env.BE_CHANGED == 'true' } }
            steps {
                script {
                    echo "Building and pushing backend Docker image..."
                    sh "docker build -t ${BE_IMAGE}:${IMAGE_TAG} ./backend"
                    sh "docker push ${BE_IMAGE}:${IMAGE_TAG}"
                    sh "docker push ${BE_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to K3s') {
            steps {
                withCredentials([string(credentialsId: "${VAULT_PASS_ID}", variable: 'VAULT_CONTENT')]) {
                    sh '''
                        # Tạo file password tạm thời để giải mã Ansible Vault
                        echo "$VAULT_CONTENT" > .vault_pass
                        
                        # Fix lỗi ANSIBLE_CONFIG trên WSL/AWS Lab
                        export ANSIBLE_CONFIG=$PWD/ansible.cfg
                        
                        if [ "$FE_CHANGED" = "true" ]; then
                           echo "Deploying Frontend update..."
                           ansible-playbook -i inventory.ini deploy.yml --tags deploy \
                           --vault-password-file .vault_pass -e "target_service=frontend image_tag=${IMAGE_TAG}"
                        fi
                        
                        if [ "$BE_CHANGED" = "true" ]; then
                           echo "Deploying Backend update..."
                           ansible-playbook -i inventory.ini deploy.yml --tags deploy \
                           --vault-password-file .vault_pass -e "target_service=backend image_tag=${IMAGE_TAG}"
                        fi
                        
                        # Xóa file password sau khi dùng xong để bảo mật
                        rm -f .vault_pass
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished. Cleaning up workspace..."
            cleanWs()
        }
        success {
            echo "CI/CD Pipeline Succeeded!"
        }
        failure {
            echo "CI/CD Pipeline Failed! Please check the logs."
        }
    }
}