pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    parameters {
        booleanParam(name: 'FORCE_BUILD_ALL', defaultValue: false, description: 'Bắt buộc build lại cả 2 service')
        booleanParam(name: 'RUN_SONAR', defaultValue: true, description: 'Chạy quét SonarQube')
    }
    environment {
        DOCKER_USER_ID = 'dockerhub' // ID trong Jenkins Credentials
        VAULT_PASS_ID  = 'ansible-vault-pass' // ID Secret Text trong Jenkins
        BACKEND_IMAGE  = 'dolciluxe-backend'
        FRONTEND_IMAGE = 'dolciluxe-frontend'
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout & Detect Changes') {
            steps {
                checkout scm
                script {
                    // Logic nhận diện thư mục nào có thay đổi so với commit trước
                    def changedFiles = sh(script: "git diff --name-only HEAD~1 HEAD", returnStdout: true).trim()
                    env.FE_CHANGED = changedFiles.contains('frontend/') || params.FORCE_BUILD_ALL
                    env.BE_CHANGED = changedFiles.contains('backend/') || params.FORCE_BUILD_ALL
                    echo "Frontend Changed: ${env.FE_CHANGED} | Backend Changed: ${env.BE_CHANGED}"
                }
            }
        }

        stage('Security Scan (SonarQube)') {
            when { expression { return params.RUN_SONAR } }
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        docker run --rm -v "$PWD:/usr/src" sonarsource/sonar-scanner-cli \
                        -Dsonar.projectKey=dolciluxe -Dsonar.sources=backend,frontend \
                        -Dsonar.host.url="http://sonarqube:9000" -Dsonar.login="$SONAR_TOKEN"
                    '''
                }
            }
        }

        stage('Parallel Build & Push') {
            parallel {
                stage('Build Frontend') {
                    when { expression { return env.FE_CHANGED == 'true' } }
                    steps {
                        withCredentials([usernamePassword(credentialsId: "${DOCKER_USER_ID}", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                            dir('frontend') {
                                sh "docker build -t ${USER}/${FRONTEND_IMAGE}:${IMAGE_TAG} ."
                                sh "docker tag ${USER}/${FRONTEND_IMAGE}:${IMAGE_TAG} ${USER}/${FRONTEND_IMAGE}:latest"
                                sh "docker push ${USER}/${FRONTEND_IMAGE}:${IMAGE_TAG}"
                                sh "docker push ${USER}/${FRONTEND_IMAGE}:latest"
                            }
                        }
                    }
                }
                stage('Build Backend') {
                    when { expression { return env.BE_CHANGED == 'true' } }
                    steps {
                        withCredentials([usernamePassword(credentialsId: "${DOCKER_USER_ID}", usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                            dir('backend') {
                                sh "docker build -t ${USER}/${BACKEND_IMAGE}:${IMAGE_TAG} ."
                                sh "docker tag ${USER}/${BACKEND_IMAGE}:${IMAGE_TAG} ${USER}/${BACKEND_IMAGE}:latest"
                                sh "docker push ${USER}/${BACKEND_IMAGE}:${IMAGE_TAG}"
                                sh "docker push ${USER}/${BACKEND_IMAGE}:latest"
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to K3s') {
            steps {
                withCredentials([string(credentialsId: "${VAULT_PASS_ID}", variable: 'VAULT_CONTENT')]) {
                    sh '''
                        echo "$VAULT_CONTENT" > .vault_pass
                        if [ "$FE_CHANGED" = "true" ]; then
                           ansible-playbook -i inventory.ini deploy.yml --tags deploy \
                           --vault-password-file .vault_pass -e "target_service=frontend image_tag=${IMAGE_TAG}"
                        fi
                        if [ "$BE_CHANGED" = "true" ]; then
                           ansible-playbook -i inventory.ini deploy.yml --tags deploy \
                           --vault-password-file .vault_pass -e "target_service=backend image_tag=${IMAGE_TAG}"
                        fi
                        rm -f .vault_pass
                    '''
                }
            }
        }
    }
    post {
        always { cleanWs() }
    }
}