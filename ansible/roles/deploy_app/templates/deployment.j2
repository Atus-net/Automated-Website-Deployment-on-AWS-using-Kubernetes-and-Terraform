apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ service_name }}
  namespace: k3s-app
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: {{ service_name }}
  template:
    metadata:
      labels:
        app: {{ service_name }}
    spec:
      nodeSelector:
        role: {{ target_node_role }}
{% if k8s_image_pull_secret is defined and (k8s_image_pull_secret | string) | length > 0 %}
      imagePullSecrets:
        - name: {{ k8s_image_pull_secret }}
{% endif %}
      containers:
        - name: {{ service_name }}
          image: latuss/dolciluxe-{{ service_name }}:{{ app_image_tag }}
          imagePullPolicy: Always
          ports:
            - containerPort: {{ (service_name == 'backend') | ternary(8080, 80) }}
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
{% if service_name == 'backend' %}
          envFrom:
            - secretRef:
                name: backend-secrets
{% endif %}
